{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated operator profile created on Google Sign-In.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address",
          "maxLength": 320
        },
        "displayName": {
          "type": "string",
          "description": "Operator display name",
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Profile avatar URL",
          "maxLength": 512
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp of most recent sign-in"
        }
      },
      "required": ["uid", "email", "displayName", "lastLoginAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private user profile isolated to the authenticated owner."
    }
  }
}
